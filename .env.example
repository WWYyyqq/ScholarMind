OPENAI_API_KEY=
# Optional: point OpenAI-compatible models at a local vLLM server.
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
TAVILY_API_KEY=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
LANGSMITH_TRACING=false

# Only necessary for Open Agent Platform
SUPABASE_KEY=
SUPABASE_URL=
# Should be set to true for a production deployment on Open Agent Platform. Should be set to false otherwise, such as for local development.
GET_API_KEYS_FROM_CONFIG=false

# Local Qwen3 example (uncomment after starting services/local-llm/start.sh):
# OPENAI_API_KEY=local
# OPENAI_BASE_URL=http://[::1]:8000/v1
# RESEARCH_MODEL=openai:qwen3-14b-local
# SUMMARIZATION_MODEL=openai:qwen3-14b-local
# COMPRESSION_MODEL=openai:qwen3-14b-local
# FINAL_REPORT_MODEL=openai:qwen3-14b-local
# SEARCH_API=none
# MAX_CONCURRENT_RESEARCH_UNITS=1
# MAX_RESEARCHER_ITERATIONS=2
# MAX_REACT_TOOL_CALLS=4

# ScholarMind local evidence Agent (project-scoped; required by the graph/API):
# SCHOLARMIND_STORAGE_BACKEND=postgres
# SCHOLARMIND_POSTGRES_DSN=postgresql://scholarmind@localhost:5432/scholarmind
# SCHOLARMIND_EMBEDDING_MODEL=qwen3-embedding-0.6b-local
# SCHOLARMIND_EMBEDDING_DIMENSION=1024
# SCHOLARMIND_EMBEDDING_BASE_URL=http://[::1]:8001/v1
# SCHOLARMIND_EMBEDDING_API_KEY=local-not-required
# SCHOLARMIND_RETRIEVAL_LIMIT=5
# Deterministic remains the safe default and does not require the 14B service.
# Set semantic only after starting services/local-llm/start.sh on port 8000.
# SCHOLARMIND_VERIFICATION_MODE=semantic
# SCHOLARMIND_VERIFIER_MODEL=qwen3-14b-local
# SCHOLARMIND_VERIFIER_BASE_URL=http://[::1]:8000/v1
# SCHOLARMIND_VERIFIER_API_KEY=local-not-required
# SCHOLARMIND_VERIFIER_MINIMUM_CONFIDENCE=0.75
