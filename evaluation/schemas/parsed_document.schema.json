{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "parsed_document.schema.json",
  "title": "ScholarMind parsed PDF document",
  "type": "object",
  "required": [
    "schema_version",
    "paper_id",
    "work_id",
    "sha256",
    "title",
    "language",
    "document_type",
    "translation_of_paper_id",
    "category",
    "indexable",
    "index_policy",
    "dataset_split",
    "tuning_allowed",
    "year",
    "pages_count",
    "coordinate_space",
    "body_font_size",
    "source_aliases",
    "parser",
    "pages",
    "chunk_count"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "paper_id": {
      "$ref": "#/$defs/paperId"
    },
    "work_id": {
      "$ref": "#/$defs/workId"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "zh",
        "unknown"
      ]
    },
    "document_type": {
      "enum": [
        "original",
        "translation"
      ]
    },
    "translation_of_paper_id": {
      "anyOf": [
        {
          "$ref": "#/$defs/paperId"
        },
        {
          "type": "null"
        }
      ]
    },
    "category": {
      "type": "string",
      "minLength": 1
    },
    "indexable": {
      "type": "boolean"
    },
    "index_policy": {
      "enum": [
        "primary",
        "auxiliary_translation",
        "primary_translation_only",
        "skip_semantic_variant"
      ]
    },
    "dataset_split": {
      "enum": ["development", "test"]
    },
    "tuning_allowed": {
      "type": "boolean"
    },
    "year": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1990,
          "maximum": 2026
        },
        {
          "type": "null"
        }
      ]
    },
    "pages_count": {
      "type": "integer",
      "minimum": 1
    },
    "coordinate_space": {
      "const": "pdf_points_top_left"
    },
    "body_font_size": {
      "type": "number",
      "minimum": 0
    },
    "source_aliases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/relativePath"
      }
    },
    "parser": {
      "type": "object",
      "required": [
        "name",
        "version",
        "parsed_at",
        "max_chunk_chars",
        "warnings"
      ],
      "properties": {
        "name": {
          "const": "pymupdf-layout-baseline"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "parsed_at": {
          "type": "string",
          "format": "date-time"
        },
        "max_chunk_chars": {
          "type": "integer",
          "minimum": 400
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "pages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/page"
      }
    },
    "chunk_count": {
      "type": "integer",
      "minimum": 0
    }
  },
  "$defs": {
    "paperId": {
      "type": "string",
      "pattern": "^paper-[0-9a-f]{16}$"
    },
    "workId": {
      "type": "string",
      "pattern": "^work-[0-9a-f]{16}$"
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?![A-Za-z]:[\\\\/]).+"
    },
    "bbox": {
      "type": "array",
      "prefixItems": [
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        },
        {
          "type": "number"
        }
      ],
      "minItems": 4,
      "maxItems": 4,
      "items": false
    },
    "textBlock": {
      "type": "object",
      "required": [
        "source_index",
        "block_id",
        "bbox",
        "bbox_normalized_top_left",
        "column",
        "text",
        "max_font_size",
        "median_font_size",
        "fonts",
        "bold",
        "reading_order",
        "is_repeated_margin",
        "is_heading"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "block_id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]*-b[0-9]+$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "bbox_normalized_top_left": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "number", "minimum": 0, "maximum": 1}
        },
        "column": {
          "enum": [
            "full",
            "left",
            "right"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "max_font_size": {
          "type": "number",
          "minimum": 0
        },
        "median_font_size": {
          "type": "number",
          "minimum": 0
        },
        "fonts": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "bold": {
          "type": "boolean"
        },
        "reading_order": {
          "type": "integer",
          "minimum": 0
        },
        "is_repeated_margin": {
          "type": "boolean"
        },
        "is_heading": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "imageBlock": {
      "type": "object",
      "required": [
        "source_index",
        "block_id",
        "bbox",
        "width",
        "height"
      ],
      "properties": {
        "source_index": {
          "type": "integer",
          "minimum": 0
        },
        "block_id": {
          "type": "string",
          "pattern": "^p[1-9][0-9]*-i[0-9]+$"
        },
        "bbox": {
          "$ref": "#/$defs/bbox"
        },
        "width": {
          "type": "integer",
          "minimum": 0
        },
        "height": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "page": {
      "type": "object",
      "required": [
        "page_number",
        "width",
        "height",
        "rotation",
        "text_blocks",
        "image_blocks",
        "text_char_count"
      ],
      "properties": {
        "page_number": {
          "type": "integer",
          "minimum": 1
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rotation": {
          "enum": [
            0,
            90,
            180,
            270
          ]
        },
        "text_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/textBlock"
          }
        },
        "image_blocks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/imageBlock"
          }
        },
        "text_char_count": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
