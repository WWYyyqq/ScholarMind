# Copy to a project-local `.env.postgres` file. Never commit the copied file.
SCHOLARMIND_POSTGRES_DB=scholarmind
SCHOLARMIND_POSTGRES_USER=scholarmind
SCHOLARMIND_POSTGRES_PASSWORD=replace-with-a-local-only-password
SCHOLARMIND_POSTGRES_PORT=5433

# Application-side settings. The password must match the value above.
SCHOLARMIND_STORAGE_BACKEND=postgres
SCHOLARMIND_POSTGRES_DSN=postgresql://scholarmind:replace-with-a-local-only-password@127.0.0.1:5433/scholarmind
